#include <iostream>
using namespace std;

int main()
{
    int a = 0;
    int b = 0;
    int input;
    while (true) {
        cin >> input;
        if (input == -10) { break; }
        if (input % 2 == 0) {
            a += input;
        }
        else {
            b ++;
        }
    }
    cout << a << '\n' << b;
}

