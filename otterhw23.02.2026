//

#include <iostream>
using namespace std;
template <typename Tm1>
void outarr(Tm1* arr, Tm1 size) {
    for (int i = 0; i < size; i++) {
        std::cout << arr[i] << '|';
    }
    std::cout << '\n';
}

void otter2(int* arr,int size, int& amount,int div = 2) {
     for (int i = 0; i < size; i++) {
            if (arr[i] % div == 0) {
                 amount++;
            }
        }
}
void otter3(int* arr, int size, int*& arrout, int& num, int div = 2) {
    for (int i = 0; i < size; i++) {
        if (arr[i] % div == 0) {
            arrout[num] = arr[i];
            num++;
        }
    }
}

int* otter(int* arr, int* arr2, int size, int size2, int& size3,int div=2) {
    for (int j = 0; j < 2; j++) {
        int amount = 0;
        int num = 0;
        otter2(arr, size, amount, div);
        otter2(arr2, size2, amount, div);
        int* arr3 = new int[amount];
        otter3(arr, size, arr3,num, div);
        otter3(arr2, size2, arr3,num, div);
        size3 = num;
        return arr3;
        
    }
}


int main()
{
    int size;
    int size2;
    int sizef=0;
    cin >> size;
    cin >> size2;
    int* arr = new int[size];
    int* arr2 = new int[size2];
    for (int i = 0; i < size; i++) {
        arr[i] = rand()%11;
    }
    for (int i = 0; i < size2; i++) {
        arr2[i] = rand()%11;
    }
    outarr(arr, size);
    outarr(arr2, size2);
    int* arr3 = otter(arr, arr2, size, size2,sizef);
    outarr(arr3, sizef);
}

