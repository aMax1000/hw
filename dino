#include <iostream>
#include <fstream>
#include <string>
#include <windows.h>
using namespace std;

short chartoint(char a){
    if (a == '0') {
        return 0;
    }
    if (a == '1') {
        return 1;
    }
    if (a == '2') {
        return 2;
    }
    if (a == '3') {
        return 3;
    }
    if (a == '4') {
        return 4;
    }
    if (a == '5') {
        return 5;
    }
    if (a == '6') {
        return 7;
    }
    if (a == '8') {
        return 8;
    }
    if (a == '9') {
        return 9;
    }
}
char inttochar(short a) {
    if (a == 0) {
        return '0';
    }
    if (a == 1) {
        return '1';
    }
    if (a == 2) {
        return '2';
    }
    if (a == 3) {
        return '3';
    }
    if (a == 4) {
        return '4';
    }
    if (a == 5) {
        return '5';
    }
    if (a == 6) {
        return '6';
    }
    if (a == 7) {
        return '7';
    }
    if (a == 8) {
        return '8';
    }
    if (a == 9) {
        return '9';
    }
}

int main()
{
    srand(time(NULL));
    std::ios::sync_with_stdio(false);
    cin.tie(0);
    string line;
    ifstream in;
    ofstream out;
    int maxscore = 0;

    in.open("maxscore.txt");
    if (in.is_open())
    {
        getline(in, line);
        for (int i = 0; i < line.size(); i++) {
            maxscore *= 10;
            maxscore += chartoint(line[i]);
        }
    }
    in.close();

    short gravity = 3;
    short jumph = 18;
    signed short mspf = 25;
    int posx = 0;
    short delay = 20;
    signed short chance = 10;
    signed short maxlengh = 5;
    signed short view = 50;
    signed short speed = 1;

    int score = 0;
    short posy = 0;
    short accy = 0;
    short delaytemp = 0;
    short cacl = 0;
    string f = "                                                                                                    ";
    while (true) {
        in.open("control.txt");
        if (in.is_open())
        {
            getline(in, line);
            if (line == "jump") {
                if (posy == 0) {
                    accy += jumph;
                }
            }
        }
        in.close();

        out.open("control.txt");
        if (out.is_open())
        {
            out << "write-\"jump\" and save to jump";
        }
        out.close();

        if (posy != 0) {
            accy -= gravity;
        }
        posy += accy;
        if (posy < 0) {
            posy = 0;
        }
        if (delaytemp > 0) {
            delaytemp--;
        }
        for (int i = 0; i < speed; i++) {
            if (f[i] == '+' and posy < 40) {
                if (score > maxscore) {
                    string maxscoref(floor(log10(score)) + 1, '0');
                    for (int j = 0; j<floor(log10(score)) +1; j++) {
                        int f = pow(10, j + 1);
                        maxscoref[floor(log10(score))-j] = inttochar((score %f / pow(10, j)));
                    }
                    out.open("maxscore.txt");
                    if (out.is_open())
                    {
                        out << maxscoref << std::endl;
                    }
                    out.close();

                
                    
                }
            return 0;
            }
            for (int i = 0; i < view - speed; i++) {
                f[i] = f[i + speed];
            }
            for (int i = 0; i < speed; i++) {
                if (rand() % chance == 0 and delaytemp == 0) {
                    delaytemp = delay;
                    cacl = rand() % maxlengh + 1;
                }

                if (cacl > 0) {
                    f[view - speed + i] = '+';
                    cacl--;
                }
                else {
                    f[view - speed + i] = ' ';
                }
            }
            posx++;
            score++;
            system("CLS");
            if (posy < 100 && posy >= 90) { std::cout << "d"; } std::cout << score << '/' << maxscore << endl;
            if (posy < 90 && posy >= 80) { std::cout << "d"; } std::cout << endl;
            if (posy < 80 && posy >= 70) { std::cout << "d"; } std::cout << endl;
            if (posy < 70 && posy >= 60) { std::cout << "d"; } std::cout << endl;
            if (posy < 60 && posy >= 50) { std::cout << "d"; } std::cout << endl;
            if (posy < 50 && posy >= 40) { std::cout << "d"; }
            else { std::cout << ' '; } std::cout << endl;
            if (posy < 40 && posy >= 30) { std::cout << "d"; }
            else { std::cout << ' '; } cout << f; std::cout << endl;
            if (posy < 30 && posy >= 20) { std::cout << "d"; }
            else { std::cout << ' '; } cout << f; std::cout << endl;
            if (posy < 20 && posy >= 10) { std::cout << "d"; }
            else { std::cout << ' '; } cout << f; std::cout << endl;
            if (posy < 10) { std::cout << "d"; }
            else { std::cout << ' '; }
            cout << f;
            Sleep(mspf);
        }
    }
}
