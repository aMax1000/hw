int sumofprogression(int a) {
	return (a * (a + 1) / 2);
}

int specialrand(int maxvalue) {
	int seed = rand()% (maxvalue * (maxvalue + 1) / 2);
	int output = 0;
	for (int i = maxvalue; i > 0; i--) {
		seed -= i;
		if (seed <	0) {
			return output;
		}
		output++;
	}
	cout << "ERROR";
	return output;
}
int specialrandexpanded(int module) {
	
	bool t = true;
	int power = 0;
	int output = 0;
	while(t){
		if(power>0){
		output+=(specialrand(module) * pow(module, power));
		}
		else {
			output += specialrand(module);
		}
		power++;
		if (rand() % module!= 0) {
			t = false;
		}
	}
	return output;
}




