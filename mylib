void outarr(int arr[], int size) {
    for (int i = 0; i < size; i++) {
        std::cout << arr[i] << '|';
    }
    std::cout << '\n';
}

void out2darr(int* arr[], int rows,int cols, int max) {
    short summax =0;
    for (int i = 1; i <= max; i *= 10) {
        summax++;
    }
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < ((summax + 1) * cols + 1); j++) {
            if (j % (summax + 1) == 0) {
                std::cout << '+';
            }
            else {
                std::cout << '-';
            }
        }
        std::cout << '\n';
        for (int j = 0; j < cols; j++) {
            std::cout << '|';
            for (int o = pow(10, summax - 1); (o > arr[i][j] and o > 1); o /= 10) {
                std::cout << ' ';
            }
            std::cout << arr[i][j];
        }
        std::cout << '|';
        std::cout << '\n';
    }
    for (int j = 0; j < ((summax + 1) * cols + 1); j++) {
        if (j % (summax + 1) == 0) {
            std::cout << '+';
        }
        else {
            std::cout << '-';
        }
    }
}

void sortarrcheck(int arr[], int size) {
    for (int i = 0; i < size-1; i++) {
        if (arr[i] > arr[i + 1]) {
            std::cout << "NO";
            return;
        }
    }
    std::cout << "YES";
}

long long longlongrand(long long max) {
    return (static_cast<long long>(35184372088832) * rand() + static_cast<long long>(1073741824) * rand() + static_cast<long long>(32768) * rand() + rand()) % (max + 1);
}
