#include <iostream>
using namespace std;
int main()
{
    srand(time(NULL));
    short l;
    short range;
    int summ=0;
    long long mult = 1;
    cin >> l;
    cin >> range;
    short* arr = new short[l];
    for (int i = 0; i < l; i++) {
        arr[i] = rand()%(2*range+1)-range;
        if (arr[i] > 0) {
            mult *= arr[i];
        }
        else {
            summ += arr[i];
        }
    }
    for (int i = 0; i < l; i++) {
        cout << arr[i] << '/';
    }
    cout << '\n' << mult <<'\n' << summ;
}
